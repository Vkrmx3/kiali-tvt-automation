{
  "name": "kiali-tvt-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Local, read-only Kiali post-release evidence collection",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "login": "tsx src/login.ts",
    "tvt": "tsx src/run-tvt.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workbook": "vitest run tests/workbook.test.ts",
    "test:browser": "vitest run tests/kiali.test.ts",
    "sample:workbook": "tsx scripts/sample-workbook.ts"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "csv-parse": "^7.0.2",
    "exceljs": "4.4.0",
    "image-size": "^2.0.2",
    "playwright": "^1.55.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}